# Copy to .env and fill in. .env is gitignored — never commit real values.
# Each var is tagged with its deploy target: [vercel] / [trigger] / [both] / [local].
# Full mapping and deploy steps: DEPLOY.md.

# [vercel] Trigger.dev secret key — triggers tasks and mints realtime tokens.
# Local dev + CLI use the DEV key; the Vercel deploy uses the PROD key (tr_prod_...).
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxx
# [local] Trigger.dev project ref — used by trigger.config.ts at deploy time.
TRIGGER_PROJECT_REF=proj_xxxxxxxx

# [both] ClickHouse Cloud — full HTTPS URL including credentials, port 8443.
# e.g. https://default:PASSWORD@abc123.eu-west-1.aws.clickhouse.cloud:8443
# Server-side only (never NEXT_PUBLIC) — the host must not reach the browser.
CLICKHOUSE_URL=

# [vercel] ClickHouse read-only user for the arena RawBLOB frame path (optional).
# Same host, arena_reader credentials. Falls back to CLICKHOUSE_URL if unset.
ARENA_READER_URL=

# [trigger] Anthropic — used by the chat agent, which runs as a Trigger task.
# Set it on the Trigger DEV and PROD envs, not on Vercel: the web app never reads it.
ANTHROPIC_API_KEY=

# [vercel] Show agent prompt content in the public dashboard. Leave 0/unset for a public link.
AGENT_LOG_PUBLIC=0
