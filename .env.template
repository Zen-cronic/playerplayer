# Copy to .env and fill in. .env is gitignored — never commit real values.

# Trigger.dev — dashboard → project → API Keys.
# Local dev uses the DEV key; the Vercel deploy uses the PROD key (tr_prod_...).
TRIGGER_PROJECT_REF=proj_xxxxxxxx
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxx

# ClickHouse Cloud — full HTTPS URL including credentials, port 8443.
# e.g. https://default:PASSWORD@abc123.eu-west-1.aws.clickhouse.cloud:8443
# Server-side only (never NEXT_PUBLIC) — the host must not reach the browser.
CLICKHOUSE_URL=

# ClickHouse read-only user for the arena RawBLOB frame path (optional).
# Same host, arena_reader credentials. Falls back to CLICKHOUSE_URL if unset.
ARENA_READER_URL=

# Anthropic — used by the chat agent, which runs as a Trigger task.
# Set this on Trigger (dev + prod envs), not on Vercel: the web app never reads it.
ANTHROPIC_API_KEY=

# Show agent prompt content in the public dashboard. Leave 0/unset for a public link.
AGENT_LOG_PUBLIC=0
