{
  "name": "playerplayer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@depot/cli",
      "canvas",
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:sdk": "pnpm --filter @playerplayer/sdk build",
    "predev": "node scripts/sync-game-assets.mjs && pnpm run build:sdk",
    "dev": "next dev",
    "dev:trigger": "trigger dev",
    "prod:trigger": "trigger deploy",
    "prebuild": "node scripts/sync-game-assets.mjs && pnpm run build:sdk",
    "build": "next build",
    "start": "next start",
    "bot": "tsx src/game/run-headless.ts",
    "arena:check": "tsx scripts/arena-check.ts",
    "arena:bench": "tsx scripts/arena-bench.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke:trigger": "tsx scripts/smoke-trigger.ts",
    "smoke:experiment": "tsx scripts/smoke-experiment.ts",
    "smoke:watch": "tsx scripts/smoke-watch.ts",
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:status": "tsx scripts/migrate.ts status",
    "migrate:verify": "tsx scripts/migrate.ts verify",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.98",
    "@ai-sdk/react": "^3.0.232",
    "@clickhouse/client": "1.23.0",
    "@geckos.io/phaser-on-nodejs": "^1.3.1",
    "@trigger.dev/sdk": "4.5.4",
    "ai": "^6.0.230",
    "next": "16.1.1",
    "phaser": "3.55.2",
    "@playerplayer/sdk": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@trigger.dev/build": "4.5.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "trigger.dev": "4.5.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  }
}
